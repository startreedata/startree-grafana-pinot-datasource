{
  "__inputs": [
    {
      "name": "DS_STARTREE_PINOT",
      "label": "StarTree Pinot",
      "description": "Select a configured StarTree Pinot data source.",
      "type": "datasource",
      "pluginId": "startree-pinot-datasource",
      "pluginName": "StarTree Pinot"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.1.1" },
    { "type": "datasource", "id": "startree-pinot-datasource", "name": "StarTree Pinot", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Example dashboard for the StarTree Pinot data source, querying the infraMetrics and hourlyEvents sample tables as time series.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "startree-pinot-datasource", "uid": "${DS_STARTREE_PINOT}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Metric value over time by metric name",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "startree-pinot-datasource", "uid": "${DS_STARTREE_PINOT}" },
          "queryType": "PinotQL",
          "editorMode": "Code",
          "displayType": "TIMESERIES",
          "tableName": "$table",
          "legend": "{{metric}}",
          "pinotQlCode": "SELECT $__timeGroup(\"ts\") AS $__timeAlias(),\n       \"metric\" AS \"metric\",\n       AVG(\"value\") AS $__metricAlias()\nFROM $__table()\nWHERE $__timeFilter(\"ts\")\nGROUP BY $__timeGroup(\"ts\"), \"metric\"\nORDER BY $__timeAlias() DESC\nLIMIT 100000"
        }
      ]
    },
    {
      "datasource": { "type": "startree-pinot-datasource", "uid": "${DS_STARTREE_PINOT}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 50, "lineWidth": 1 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Total value over time",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "startree-pinot-datasource", "uid": "${DS_STARTREE_PINOT}" },
          "queryType": "PinotQL",
          "editorMode": "Code",
          "displayType": "TIMESERIES",
          "tableName": "$table",
          "legend": "total",
          "pinotQlCode": "SELECT $__timeGroup(\"ts\") AS $__timeAlias(),\n       SUM(\"value\") AS $__metricAlias()\nFROM $__table()\nWHERE $__timeFilter(\"ts\")\nGROUP BY $__timeGroup(\"ts\")\nORDER BY $__timeAlias() DESC\nLIMIT 100000"
        }
      ]
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": ["startree", "pinot", "example"],
  "templating": {
    "list": [
      {
        "name": "table",
        "label": "Pinot table",
        "description": "Sample table to query. Both panels need a numeric `value` column and a `ts` time column (infraMetrics, hourlyEvents); the 'by metric name' panel additionally needs a `metric` column, which only infraMetrics has.",
        "type": "custom",
        "query": "infraMetrics, hourlyEvents",
        "current": { "selected": true, "text": "infraMetrics", "value": "infraMetrics" },
        "options": [
          { "selected": true, "text": "infraMetrics", "value": "infraMetrics" },
          { "selected": false, "text": "hourlyEvents", "value": "hourlyEvents" }
        ],
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false,
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "StarTree Pinot — Infrastructure Metrics",
  "uid": "startree-pinot-infra-metrics",
  "version": 1,
  "weekStart": ""
}
