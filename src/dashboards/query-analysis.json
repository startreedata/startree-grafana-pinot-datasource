      "pluginId": "startree-pinot-datasource",
      "pluginName": "StarTree Pinot"
    }
  ],
  "__elements": {},
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.1.1"
    },
    {
      "type": "datasource",
      "id": "startree-pinot-datasource",
      "name": "StarTree Pinot",
      "version": "1.0.0"
    },
    {
      "type": "panel",
