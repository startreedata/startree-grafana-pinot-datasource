{
  "__inputs": [
    {
      "name": "DS_STARTREE_PINOT",
      "label": "StarTree Pinot",
      "description": "Select the StarTree Pinot datasource to bind this dashboard to.",
      "type": "datasource",
      "pluginId": "startree-pinot-datasource",
      "pluginName": "StarTree Pinot"
    }
  ],
  "__elements": {},
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.1.1"
    },
    {
      "type": "datasource",
      "id": "startree-pinot-datasource",
      "name": "StarTree Pinot",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "logs",
      "name": "Logs",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Templated example for the StarTree Pinot datasource. Pick any table in your cluster; the time, metric, and log-message columns auto-populate from that table's schema. Works against any Pinot table without editing SQL.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "startree-pinot-datasource",
        "uid": "${DS_STARTREE_PINOT}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "$metricColumn over time — $table",
      "targets": [
        {
          "datasource": {
            "type": "startree-pinot-datasource",
            "uid": "${DS_STARTREE_PINOT}"
          },
          "refId": "A",
          "queryType": "PinotQL",
          "editorMode": "Code",
          "displayType": "TIMESERIES",
          "tableName": "$table",
          "legend": "$metricColumn",
          "pinotQlCode": "SELECT\n  $__timeGroup(\"$timeColumn\") AS $__timeAlias(),\n  AVG(\"$metricColumn\") AS $__metricAlias()\nFROM $__table()\nWHERE $__timeFilter(\"$timeColumn\")\nGROUP BY $__timeGroup(\"$timeColumn\")\nORDER BY $__timeAlias()\nLIMIT 100000"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "startree-pinot-datasource",
        "uid": "${DS_STARTREE_PINOT}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true
      },
      "title": "Recent rows — $table",
      "targets": [
        {
          "datasource": {
            "type": "startree-pinot-datasource",
            "uid": "${DS_STARTREE_PINOT}"
          },
          "refId": "A",
          "queryType": "PinotQL",
          "editorMode": "Code",
          "displayType": "TABLE",
          "tableName": "$table",
          "pinotQlCode": "SELECT *\nFROM $__table()\nWHERE $__timeFilter(\"$timeColumn\")\nORDER BY \"$timeColumn\" DESC\nLIMIT 100"
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "startree-pinot-datasource",
        "uid": "${DS_STARTREE_PINOT}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "title": "$logColumn log lines — $table",
      "targets": [
        {
          "datasource": {
            "type": "startree-pinot-datasource",
            "uid": "${DS_STARTREE_PINOT}"
          },
          "refId": "A",
          "queryType": "PinotQL",
          "editorMode": "Code",
          "displayType": "LOGS",
          "tableName": "$table",
          "pinotQlCode": "SELECT\n  \"$logColumn\" AS \"__message\",\n  \"$timeColumn\" AS \"__time\"\nFROM $__table()\nWHERE $__timeFilter(\"$timeColumn\")\nORDER BY \"$timeColumn\" DESC\nLIMIT 200"
        }
      ],
      "type": "logs"
    }
  ],
  "refresh": "",
